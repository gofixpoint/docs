{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Amika",
  "colors": {
    "primary": "#25437F",
    "light": "#4A7FBF",
    "dark": "#4D77CB"
  },
  "background": {
    "color": {
      "light": "#F9F8F6",
      "dark": "#1C1917"
    }
  },
  "fonts": {
    "heading": {
      "family": "Plus Jakarta Sans",
      "weight": 700
    },
    "body": {
      "family": "IBM Plex Sans",
      "weight": 400
    }
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"

  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Sandboxes and environments",
            "pages": [
              "guides/sandbox-configuration",
              "guides/presets"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "guides/auth-extract"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "CLI and API",
            "pages": [
              "reference/cli-reference",
              "reference/http-api"
            ]
          },
          {
            "group": "System reference",
            "pages": [
              "reference/storage"
            ]
          }
        ]
      },
      {
        "tab": "Architecture",
        "groups": [
          {
            "group": "System design",
            "pages": [
              "architecture/overview",
              "architecture/roadmap"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://www.amika.dev",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Pricing",
          "href": "https://www.amika.dev/pricing",
          "icon": "dollar-sign"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/gofixpoint/amika",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://discord.gg/xDXk4KjGWg"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Book a demo",
      "href": "https://cal.com/amika-ai/demo"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/gofixpoint/amika"
    }
  }
}
