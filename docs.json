{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Amika",
  "colors": {
    "primary": "#25437F",
    "light": "#4A7FBF",
    "dark": "#4D77CB"
  },
  "background": {
    "color": {
      "light": "#F9F8F6",
      "dark": "#1C1917"
    }
  },
  "fonts": {
    "heading": {
      "family": "Plus Jakarta Sans",
      "weight": 700
    },
    "body": {
      "family": "IBM Plex Sans",
      "weight": 400
    }
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"

  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "install",
              "guides/overview"
            ]
          },
          {
            "group": "Sandboxes",
            "pages": [
              "guides/create-a-sandbox",
              "guides/sandbox-lifecycle",
              "guides/ssh-and-connect"
            ]
          },
          {
            "group": "Agents and sessions",
            "pages": [
              "guides/send-a-message-to-an-agent",
              "guides/manage-sessions"
            ]
          },
          {
            "group": "Credentials",
            "pages": [
              "guides/manage-secrets",
              "guides/inject-credentials"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "guides/setup-repo-config-with-agent",
              "guides/programmatic-usage",
              "guides/mcp-integrations"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "sdks/overview"
            ]
          },
          {
            "group": "TypeScript",
            "pages": [
              "sdks/typescript/quickstart",
              "sdks/typescript/client",
              "sdks/typescript/types",
              "sdks/typescript/errors",
              "sdks/typescript/token-sources"
            ]
          }
        ]
      },
      {
        "tab": "CLI and API Reference",
        "groups": [
          {
            "group": "CLI and platform",
            "pages": [
              "reference/cli",
              "reference/auth",
              "reference/secrets",
              "reference/presets",
              "reference/sandbox-configuration",
              "reference/storage"
            ]
          },
          {
            "group": "Repository configuration",
            "pages": [
              "reference/repository-configuration",
              "reference/config-toml",
              "reference/services"
            ]
          },
          {
            "group": "HTTP API",
            "pages": [
              "reference/api-reference",
              "reference/http-api",
              "reference/amika-server-cli-reference"
            ]
          }
        ]
      },
      {
        "tab": "Architecture",
        "groups": [
          {
            "group": "System design",
            "pages": [
              "architecture/overview",
              "architecture/roadmap"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://www.amika.dev",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Pricing",
          "href": "https://www.amika.dev/pricing",
          "icon": "dollar-sign"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/gofixpoint/amika",
          "icon": "github"
        }
      ]
    }
  },
